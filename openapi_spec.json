{
  "openapi": "3.1.0",
  "info": {
    "title": "Vaccine VAERS Lot Safety Agent — illustrative audit API",
    "version": "3.0.0",
    "description": "Generic rule-based task classifications, not epidemiologic VAERS safety analysis. Use the CLI lots subcommand for descriptive VAERSVAX counts."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON counters (not Prometheus text)",
        "responses": {
          "200": {
            "description": "Counter snapshot"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate illustrative generic thresholds",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ],
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  },
                  "attributes": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Illustrative classification dossier"
          },
          "422": {
            "description": "Invalid payload"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-process HMAC audit metadata",
        "responses": {
          "200": {
            "description": "Audit chain and verification result"
          }
        }
      }
    }
  }
}
